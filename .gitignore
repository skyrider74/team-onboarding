*[Pp][Rr][Ii][Vv][Aa][Tt][Ee][Kk][Ee][Yy]*
*[Pp][Rr][Ii][Vv][Aa][Tt][Ee]-[Kk][Ee][Yy]*
*[Pp][Rr][Ii][Vv][Kk][Ee][Yy]*
*[Pp][Aa][Yy][Rr][Oo][Ll][Ll]*
*[Ss][Aa][Ll][Aa][Rr][Yy]*
*[Pp][Ii][Ii]*
*[Ss][Ss][Nn]*
*[Ee][Mm][Pp][Ll][Oo][Yy][Ee][Ee]-[Ll][Ii][Ss][Tt]*
*[Ee][Mm][Pp][Ll][Oo][Yy][Ee][Ee][Ll][Ii][Ss][Tt]*
*[Pp][Ee][Rr][Ss][Oo][Nn][Aa][Ll]-[Ii][Nn][Ff][Oo]*
*[Pp][Ee][Rr][Ss][Oo][Nn][Aa][Ll][Ii][Nn][Ff][Oo]*
*[Rr][Ee][Ss][Ii][Dd][Ee][Nn][Tt]-[Ii][Dd]*
*[Ii][Dd][Cc][Aa][Rr][Dd]*
*[Pp][Aa][Ss][Ss][Pp][Oo][Rr][Tt]*
*[Bb][Aa][Nn][Kk][Aa][Cc][Cc][Oo][Uu][Nn][Tt]*
*[Bb][Aa][Nn][Kk]-[Aa][Cc][Cc][Oo][Uu][Nn][Tt]*
*[Aa][Cc][Cc][Oo][Uu][Nn][Tt][Ii][Nn][Ff][Oo]*
*[Aa][Cc][Cc][Oo][Uu][Nn][Tt]-[Ii][Nn][Ff][Oo]*

