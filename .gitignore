!*.[Ss][Aa][Mm][Pp][Ll][Ee]
!*.[Tt][Ee][Mm][Pp][Ll][Aa][Tt][Ee]
!/.env.example
!/.gitignore
!/.gitattributes
!/.githooks/**
!/.github/**
